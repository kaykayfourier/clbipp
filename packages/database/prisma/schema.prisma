generator client {
  provider      = "prisma-client-js"
  // Explicit output (gitignored): resolves correctly regardless of npm
  // hoisting in the workspace; Prisma 6 deprecates the default path anyway.
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BatteryPack {
  id                 String              @id @default(uuid())
  packAadhaar        String              @unique @map("pack_aadhaar")
  weightKg           Decimal?            @map("weight_kg") @db.Decimal(8, 2)
  chemistry          Chemistry
  manufacturer       String?
  modelNumber        String?             @map("model_number")
  nominalCapacityKwh Decimal?            @map("nominal_capacity_kwh") @db.Decimal(8, 2)
  nominalVoltage     Decimal?            @map("nominal_voltage") @db.Decimal(8, 2)
  manufactureDate    DateTime?           @map("manufacture_date")
  createdAt          DateTime            @default(now()) @map("created_at")
  inspections        BatteryInspection[]
  decisions          PathwayDecision[]

  @@map("battery_packs")
}

model BatteryInspection {
  id                    String              @id @default(uuid())
  packId                String              @map("pack_id")
  inspectionTimestamp   DateTime            @default(now()) @map("inspection_timestamp")
  inspectorId           String?             @map("inspector_id")
  visualScore           Int?                @map("visual_score")
  leakageScore          Int?                @map("leakage_score")
  thermalScore          Int?                @map("thermal_score")
  damageScore           Decimal?            @map("damage_score") @db.Decimal(4, 2)
  sohPct                Decimal?            @map("soh_pct") @db.Decimal(5, 2)
  socPct                Decimal?            @map("soc_pct") @db.Decimal(5, 2)
  entropyValue          Decimal?            @map("entropy_value") @db.Decimal(8, 4)
  entropyAnomaliesCount Int                 @default(0) @map("entropy_anomalies_count")
  irImbalanceRatio      Decimal?            @map("ir_imbalance_ratio") @db.Decimal(6, 3)
  voltageImbalanceMv    Decimal?            @map("voltage_imbalance_mv") @db.Decimal(6, 1)
  tempMaxC              Decimal?            @map("temp_max_c") @db.Decimal(5, 2)
  cycleCount            Int?                @map("cycle_count")
  rulMonths             Int?                @map("rul_months")
  notes                 String?
  diagnostics           BatteryDiagnostic[]
  pack                  BatteryPack         @relation(fields: [packId], references: [id], onDelete: Cascade)
  decisions             PathwayDecision[]

  @@map("battery_inspections")
}

model BatteryDiagnostic {
  id               String            @id @default(uuid())
  inspectionId     String            @map("inspection_id")
  cellDataSnapshot Json?             @map("cell_data_snapshot")
  createdAt        DateTime          @default(now()) @map("created_at")
  inspection       BatteryInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("battery_diagnostics")
}

model MarketPrices {
  id String  @id @default(uuid())
  Li Decimal @map("Li_price")
  Co Decimal @map("Co_price")
  Ni Decimal @map("Ni_price")
  Mn Decimal @map("Mn_price")
  Cu Decimal @map("Cu_price")
  Al Decimal @map("Al_price")

  // ── Admin console (admin_app_v1, W6) ──────────────────────────────────────
  // The market feed screen (C02) shows all four of these and none existed.
  //
  // `fxRateUsdInr` replaces the hardcoded 83.2 at packages/core/src/market.ts.
  // 🔴 The default is that exact number ON PURPOSE: the engine echoes the rate
  // into its audit output and does no arithmetic with it (metal_price is
  // already ₹/kg), so seeding anything else would change what a quote SAYS it
  // was priced against. No price moves.
  //
  // `source` is where the row came from — 'seed', 'manual-override', or a feed
  // name once one exists. `createdBy` is the admin who typed an override, null
  // for a machine-written row; W7's audit trail is AdminAudit, this is just the
  // authorship stamp on the row itself.
  fxRateUsdInr Decimal @default(83.2) @map("fx_rate_usd_inr") @db.Decimal(10, 4)
  source       String?
  note         String?
  createdBy    String? @map("created_by") @db.Uuid

  updatedAt DateTime @default(now()) @map("updated_at")

  author Profile? @relation(fields: [createdBy], references: [id])

  // getMarketData() reads `findFirst orderBy updatedAt desc` on every quote.
  @@index([updatedAt(sort: Desc)])
  @@map("market_prices")
}

model PathwayFactor {
  id                   String            @id @default(uuid())
  configVersion        String            @map("config_version")
  processingRatePerKg  Decimal?          @map("processing_rate_per_kg")
  refurbLaborRatePerKg Decimal?          @map("refurb_labor_rate_per_kg")
  cellReplacementRate  Decimal?          @map("cell_replacement_rate")
  ageCap               Int?              @map("age_cap")
  cycleCap             Int?              @map("cycle_cap")
  testingRatePerKg     Decimal?          @map("testing_rate_per_kg")
  hydrometRatePerKg    Decimal?          @map("hydromet_rate_per_kg")
  chemistryComposition Json?             @map("chemistry_composition")
  isActive             Boolean           @default(true) @map("is_active")
  effectiveFrom        DateTime?         @map("effective_from")
  effectiveTo          DateTime?         @map("effective_to")
  createdAt            DateTime          @default(now()) @map("created_at")
  decisions            PathwayDecision[]

  @@map("pathway_factors")
}

model PathwayDecision {
  id                String            @id @default(uuid())
  packId            String            @map("pack_id")
  inspectionId      String            @map("inspection_id")
  factorConfigId    String            @map("factor_config_id")
  // The engine's own run identifier (TRC-YYYY-NNNN, minted in
  // decisionEngine/layers/intake.ts). Added agent_app_v1: BatteryItem.traceId
  // is what an agent screen carries around, and without this column it pointed
  // at nothing. Nullable because rows predating the agent app have no trace.
  traceId           String?           @unique @map("trace_id")
  pathway           Pathway
  costBreakdown     Json?             @map("cost_breakdown")
  revenueBreakdown  Json?             @map("revenue_breakdown")
  netRevenue        Decimal?          @map("net_revenue") @db.Decimal(12, 2)
  costsTotal        Decimal?          @map("costs_total") @db.Decimal(12, 2)
  pMin              Decimal?          @map("p_min") @db.Decimal(12, 2)
  pRecommended      Decimal?          @map("p_recommended") @db.Decimal(12, 2)
  pMax              Decimal?          @map("p_max") @db.Decimal(12, 2)
  confidenceScore   Decimal?          @map("confidence_score") @db.Decimal(4, 3)
  decisionRationale String?           @map("decision_rationale")
  createdAt         DateTime          @default(now()) @map("created_at")
  factorConfig      PathwayFactor     @relation(fields: [factorConfigId], references: [id])
  inspection        BatteryInspection @relation(fields: [inspectionId], references: [id])
  pack              BatteryPack       @relation(fields: [packId], references: [id])

  @@map("pathway_decisions")
}

enum Chemistry {
  LFP
  NMC622
  NMC811
  LCO
}

enum Pathway {
  REUSE
  REFURBISH
  RECYCLE
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum VendorType {
  individual
  fleet
}

enum KycStatus {
  pending
  submitted
  verified
  rejected
}

// Ordered lifecycle + the `cancelled` side-state.
//
// 🔴 `cancelled` is NOT terminal — it is RE-ENTERABLE (changed 2026-08-23, and
// this comment said "terminal" until 2026-08-31). HR asked for
// reschedule-after-cancel, so `reschedulePickup` in the customer app's
// `handover/actions.ts` writes `cancelled → requested` to reactivate a pickup
// rather than making the vendor file a new request. Still nine stages, no
// migration. Don't write code that assumes a cancelled pickup is final.
//
// Two consequences that are still live:
//   · the audit log can go BACKWARDS — a `requested` status_events row can land
//     after a `cancelled` one. `buildStages` is first-wins so the timeline still
//     reads forwards, but the ordering fact is unchanged.
//   · a reactivated pickup keeps its old `agentId` / `agentFeePaise`. The
//     admin's /dispatch clears them on assignment; nothing else does.
//     Seed fixture 8 (PKP-2026-000114) exists to keep this visible.
//
// `arrived` and
// `offered` were added 2026-08-09 (Batch 7A): the company flow document puts
// assessment and quoting ON SITE, and until this change "an offer exists" was an
// implicit sub-state of `scheduled` rather than a status — which is what made
// the offer screens unreachable in Batch 6.5.
//
// The customer-facing display order lives in `LIFECYCLE_STAGES`
// (packages/ui/src/tokens.ts) and must match this list.
enum PickupStatus {
  requested
  scheduled
  arrived
  offered
  collected
  tested
  processed
  recovered
  certified
  cancelled
}

enum BatteryType {
  li_ion_nmc
  li_ion_lfp
  li_ion_nca
  lead_acid
  nimh
  other
}

enum RecoveryPathway {
  recycle
  refurbish
  reuse
  dispose
}

enum UserRole {
  customer
  agent
  admin
}

enum BatteryCategory {
  portable
  automotive
  industrial
  ev
}

enum BatteryCondition {
  healthy
  swollen
  leaking
  dead
}

enum AddressStatus {
  operational
  not_operational
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
}

enum PaymentMethod {
  upi
  bank_transfer
  wallet
  cash
}

enum WalletTxnKind {
  payout
  redemption
  adjustment
  // What the FIELD AGENT earns for a job, not what a vendor is paid (D3).
  // Appended last so no existing value's ordinal shifts.
  agent_fee
}

enum ManifestStatus {
  draft
  dispatched
  received
  reconciled
}

// ── Admin console (admin_app_v1) ─────────────────────────────────────────────

// The two engine decision flags an admin can be asked to clear (W4/AD4).
// These are ENGINE flags, not pickup statuses — nothing here touches
// PickupStatus, and there is deliberately no per-item status column (AD6).
enum ExceptionKind {
  hold
  review
}

// How an admin closed an ItemException. Null resolution + null resolvedAt is
// what "open" means; there is no separate open/closed column to drift.
enum ExceptionResolution {
  retest
  override
  reject
}

// 🔴 MUST stay in step with `keyof Config["margin_tiers"]` in
// packages/decision-engine/src/decisionEngine/types.ts. The engine already
// honours Config.supplier_margin_overrides (selection.ts) — it had nowhere to
// persist, which is the whole of W11.
enum MarginTier {
  aggressive
  standard
  generous
}

// ── Models ───────────────────────────────────────────────────────────────────

model Profile {
  id         String     @id @db.Uuid
  vendorType VendorType @map("vendor_type")
  // Drives which app a session may enter. Middleware reads this.
  role       UserRole   @default(customer)

  fullName      String  @map("full_name")
  email         String
  phone         String?
  // Collected at signup now; flipped true when we add SMS OTP later.
  phoneVerified Boolean @default(false) @map("phone_verified")

  companyName     String? @map("company_name")
  gstNumber       String? @map("gst_number")
  panNumber       String? @map("pan_number")
  businessAddress String? @map("business_address")
  eprRegId        String? @map("epr_reg_id")

  kycStatus  KycStatus @default(pending) @map("kyc_status")
  kycDocUrls String[]  @map("kyc_doc_urls")

  // Denormalised cache of sum(wallet_txns.delta_paise). WalletTxn is the source
  // of truth; always write both in one transaction (same pattern as
  // pickups.status vs status_events).
  walletBalancePaise Int @default(0) @map("wallet_balance_paise")

  // ── Admin console (admin_app_v1, W11) ────────────────────────────────────
  // Which margin tier the engine prices this supplier at. Read into
  // Config.supplier_margin_overrides by the admin app; null means the tier in
  // the active EngineConfig applies unchanged.
  //
  // ⚠ W11 also called for an `eprRegNo` column. NOT ADDED — `eprRegId` above is
  // already that column and is wired end to end (the fleet signup form,
  // onboarding, validation.ts, auth.ts's select list, grants.sql's writable
  // allowlist, and the vendor profile screen). A second column would start null
  // for every real vendor and guarantee drift. The admin Suppliers screen reads
  // `eprRegId`. See "Batch 1 — as built" in docs/ADMIN_TASKS.md.
  marginTier MarginTier? @map("margin_tier")

  // agent-only (null for customer/admin) — used by the Agent app
  agentZone       String?   @map("agent_zone")
  agentVehicle    String?   @map("agent_vehicle")
  safetyTrainedAt DateTime? @map("safety_trained_at")
  agentRating     Decimal?  @map("agent_rating") @db.Decimal(3, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Two relations to Pickup (as vendor, as assigned agent) so both MUST be
  // named — Prisma cannot disambiguate them otherwise.
  pickups         Pickup[]       @relation("VendorPickups")
  assignedPickups Pickup[]       @relation("AgentPickups")
  addresses       Address[]
  offers          Offer[]
  certificates    Certificate[]
  payments        Payment[]
  walletTxns      WalletTxn[]
  invoices        Invoice[]
  custodyBatches  CustodyBatch[]

  // Admin console (admin_app_v1). Four separate relations, no @relation names
  // needed — each points at a different model, so Prisma can tell them apart.
  publishedConfigs   EngineConfig[]
  adminAudits        AdminAudit[]
  resolvedExceptions ItemException[]
  marketOverrides    MarketPrices[]

  @@index([role])
  @@map("profiles")
}

model Address {
  id        String @id @default(uuid())
  profileId String @map("profile_id") @db.Uuid

  label   String // "Warehouse", "Home", "Depot 2"
  line1   String
  line2   String?
  city    String
  state   String
  pincode String

  // Captured from navigator.geolocation at add-time. Nullable: manual entry
  // must stay possible when the user denies location permission.
  lat Decimal? @db.Decimal(10, 7)
  lng Decimal? @db.Decimal(10, 7)

  status    AddressStatus @default(operational)
  isDefault Boolean       @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pickups Pickup[]

  @@index([profileId])
  @@map("addresses")
}

// A Pickup is now a HEADER row: who, where, when, which category, which agent.
// The battery detail lives in BatteryItem (company build doc §6).
model Pickup {
  id       String  @id
  vendorId String  @map("vendor_id") @db.Uuid
  agentId  String? @map("agent_id") @db.Uuid

  // Customer picks category at booking; the agent tags chemistry per item
  // on-site. Two different questions — see COMPANY_FLOW_REVIEW.
  category  BatteryCategory @default(portable)
  addressId String?         @map("address_id")

  // ── Superseded by BatteryItem. Nullable now, kept so existing rows and the
  // old request form don't break during the transition. Do not build new
  // reads against these three. ──
  // @map kept deliberately: BATCH_0B_SCHEMA.md §2 omits it, which would rename
  // the live `battery_type` column (dropping 10 rows) and break the raw
  // PostgREST insert in the old request form. Flagged to B.
  batteryType    BatteryType? @map("battery_type")
  approxQuantity String?      @map("approx_quantity")
  approxWeightKg Decimal?     @map("approx_weight_kg")

  // Free-text address. Still required; backfilled into Address by the seed.
  location String

  preferredDate DateTime? @map("preferred_date") @db.Date
  scheduledSlot DateTime? @map("scheduled_slot")
  etaMinutes    Int?      @map("eta_minutes")

  // Shown to the customer at booking, before any agent sees the request.
  indicativeQuotePaise Int?               @map("indicative_quote_paise")
  // Customer's own self-report. The agent's assessment is per-item.
  conditionFlags       BatteryCondition[] @map("condition_flags")

  notes       String?
  photoUrls   String[] @map("photo_urls")
  publicToken String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_token") @db.Uuid

  status PickupStatus @default(requested)

  // What the AGENT earns for this job, distinct from what the vendor is paid
  // (D3). Null until the agent's fee is computed — B's Batch 4 owns the rule.
  agentFeePaise Int? @map("agent_fee_paise")

  // Set when the agent hands this pickup in at a hub. Null on a collected
  // pickup is exactly what "pending drop-off" means — that wireframe state is
  // DERIVED from this column, not a tenth lifecycle stage (D5).
  custodyBatchId String? @map("custody_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  vendor          Profile          @relation("VendorPickups", fields: [vendorId], references: [id])
  agent           Profile?         @relation("AgentPickups", fields: [agentId], references: [id])
  address         Address?         @relation(fields: [addressId], references: [id])
  custodyBatch    CustodyBatch?    @relation(fields: [custodyBatchId], references: [id])
  items           BatteryItem[]
  statusEvents    StatusEvent[]
  offer           Offer?
  certificate     Certificate?
  payment         Payment?
  receipt         PickupReceipt?
  invoice         Invoice?
  safetyChecklist SafetyChecklist?

  @@index([vendorId])
  @@index([agentId])
  @@index([status])
  @@index([custodyBatchId])
  @@index([createdAt(sort: Desc)])
  @@map("pickups")
}

// THE centre of this rework. One row per battery line in a request.
// Two halves: what the customer declared, and what the agent confirmed on site.
model BatteryItem {
  id       String @id @default(uuid())
  pickupId String @map("pickup_id")

  // ── Customer-declared at booking ──
  category  BatteryCategory
  quantity  Int              @default(1)
  weightKg  Decimal?         @map("weight_kg") @db.Decimal(8, 2)
  condition BatteryCondition @default(healthy)
  photoUrls String[]         @map("photo_urls")

  // ── Agent-confirmed on site (all null until collection) ──
  chemistry          BatteryType?
  confirmedWeightKg  Decimal?          @map("confirmed_weight_kg") @db.Decimal(8, 2)
  confirmedCondition BatteryCondition? @map("confirmed_condition")
  agentPhotoUrls     String[]          @map("agent_photo_urls")
  recordedBy         String?           @map("recorded_by") @db.Uuid
  recordedAt         DateTime?         @map("recorded_at")

  // ── Damage rubric, scored by the agent on site (D1 — the engine runs PER
  // ITEM, so the rubric lives here and not on the Pickup header). The three
  // sub-scores are the agent's raw input; damageScore is what the engine
  // derives from them. Decimal(4,2) deliberately matches
  // BatteryInspection.damageScore — same rubric, same precision. ──
  damageVisual  Int?     @map("damage_visual")
  damageLeakage Int?     @map("damage_leakage")
  damageThermal Int?     @map("damage_thermal")
  damageScore   Decimal? @map("damage_score") @db.Decimal(4, 2)

  // ── Engine verdict for THIS item. traceId is the engine's own run id
  // (TRC-YYYY-NNNN) and joins to pathway_decisions.trace_id. ──
  pathway RecoveryPathway?
  traceId String?          @map("trace_id")

  // ── Pricing (paise, integers only — never floats for money) ──
  unitPricePaise Int? @map("unit_price_paise")
  linePricePaise Int? @map("line_price_paise")

  // ⚠ WORKAROUND (Batch 5a, Ali — 2026-08-23), not in the original plan.
  // computeQuote() requires a full BMSData object — soh_nominal, capacity_kWh,
  // age_years, cycle_count, plus four BMS diagnostic readings — and NO screen
  // in the corrected screen map (plan §2) collects them; Entroview sync is out
  // for v1 and no manual-BMS-entry screen was ever specced. Team direction
  // (2026-08-23): collect the four decision-relevant fields (SoH/capacity/
  // age/cycles) on the damage rubric screen and default the four diagnostic-
  // only fields to "no anomaly detected" until Entroview or the admin
  // dashboard supplies real readings — see DamageRubricForm.tsx.
  //
  // PathwayDecision (packId/inspectionId/factorConfigId) is the schema's real
  // audit table for an engine run, but those three FKs point at BatteryPack /
  // BatteryInspection / PathwayFactor — the OLD single-pack test harness, with
  // zero seeded rows and no defined mapping onto Pickup → BatteryItem. Rather
  // than mint throwaway pack/inspection/factor rows just to satisfy those FKs,
  // this column stores the full { input: QuoteInput, output: QuoteOutput }
  // pair straight from the engine, so /result, /result/breakdown and
  // /result/why can re-render after navigation without recomputing.
  //
  // TODO: replace with the real PathwayDecision audit trail once the admin
  // dashboard defines the pack/inspection/factor-config linkage for the agent
  // app. This column is a stand-in, not the intended long-term record.
  quoteData Json? @map("quote_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  pickup     Pickup          @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  exceptions ItemException[]

  @@index([pickupId])
  // /quotes and /trace/[traceId] both look an item up by its engine run id.
  // NOT unique: a flat-rate (non-li-ion) item has no traceId at all, and a
  // re-quote of the same item would reuse one. pathway_decisions.trace_id is
  // the unique side of that join.
  @@index([traceId])
  @@map("battery_items")
}

// Drives both the customer's indicative quote and the agent's payout.
// A row with null chemistry/condition is the category-wide fallback.
model PricingRate {
  id String @id @default(uuid())

  category  BatteryCategory
  chemistry BatteryType?
  condition BatteryCondition?

  ratePerKgPaise        Int  @map("rate_per_kg_paise")
  ratePerUnitPaise      Int? @map("rate_per_unit_paise")
  // Basis points, 10000 = 1.00x. Integer so money math never touches a float.
  conditionMultiplierBp Int  @default(10000) @map("condition_multiplier_bp")

  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, isActive])
  @@map("pricing_rates")
}

// Append-only event log. NEVER update a row here — insert a new one.
// pickups.status is the denormalised fast-read cache of the latest event.
model StatusEvent {
  id         BigInt       @id @default(autoincrement())
  pickupId   String       @map("pickup_id")
  status     PickupStatus
  actorId    String?      @map("actor_id") @db.Uuid
  actorRole  String?      @map("actor_role")
  notes      String?
  // Chain-of-custody (company doc §5.3): where + photo proof per transition.
  lat        Decimal?     @db.Decimal(10, 7)
  lng        Decimal?     @db.Decimal(10, 7)
  photoUrls  String[]     @map("photo_urls")
  occurredAt DateTime     @default(now()) @map("occurred_at")

  pickup Pickup @relation(fields: [pickupId], references: [id])

  @@index([pickupId])
  @@index([occurredAt])
  @@map("status_events")
}

model Offer {
  id       BigInt @id @default(autoincrement())
  pickupId String @unique @map("pickup_id")
  vendorId String @map("vendor_id") @db.Uuid

  pathway           RecoveryPathway
  // PAISE. 18450000 = ₹1,84,500. See packages/core formatOfferPrice().
  estimatedPrice    Int             @map("estimated_price")
  rationale         String
  materialBreakdown Json            @default("[]") @map("material_breakdown")
  deductions        Json            @default("[]")

  // D7, the cross-app seam. The VENDOR accepting an offer sets this and nothing
  // else — status stays `offered`. Only the AGENT can move a pickup to
  // `collected`, because a vendor cannot mark their own battery collected.
  // Written by the customer app (Batch 5b), read by the agent app (Batch 6).
  acceptedAt DateTime? @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")

  pickup Pickup  @relation(fields: [pickupId], references: [id])
  vendor Profile @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("offers")
}

model Payment {
  id       String @id @default(uuid())
  pickupId String @unique @map("pickup_id")
  vendorId String @map("vendor_id") @db.Uuid

  amountPaise Int           @map("amount_paise")
  method      PaymentMethod @default(upi)
  status      PaymentStatus @default(pending)

  // Populated only when PAYMENTS_MODE=razorpay. Null in simulated mode.
  gatewayRef   String?   @map("gateway_ref")
  gatewayOrder String?   @map("gateway_order")
  paidAt       DateTime? @map("paid_at")
  failureNote  String?   @map("failure_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  pickup Pickup  @relation(fields: [pickupId], references: [id])
  vendor Profile @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("payments")
}

// Append-only ledger. profiles.wallet_balance_paise is the cache.
model WalletTxn {
  id        String @id @default(uuid())
  profileId String @map("profile_id") @db.Uuid

  deltaPaise        Int           @map("delta_paise") // signed: +credit / -debit
  kind              WalletTxnKind
  balanceAfterPaise Int           @map("balance_after_paise")
  pickupId          String?       @map("pickup_id")
  note              String?

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id])

  @@index([profileId, createdAt(sort: Desc)])
  @@map("wallet_txns")
}

// Company doc §4 step 4: the receipt handed over AT COLLECTION.
// This is NOT the EPR certificate — that comes at step 8, after recycling.
model PickupReceipt {
  id       String @id @default(uuid())
  pickupId String @unique @map("pickup_id")

  receiptNo   String  @unique @map("receipt_no")
  pdfUrl      String? @map("pdf_url")
  publicToken String  @unique @default(dbgenerated("gen_random_uuid()")) @map("public_token") @db.Uuid

  totalWeightKg Decimal @map("total_weight_kg") @db.Decimal(10, 2)
  itemCount     Int     @map("item_count")
  amountPaise   Int?    @map("amount_paise")

  agentId     String?  @map("agent_id") @db.Uuid
  capturedLat Decimal? @map("captured_lat") @db.Decimal(10, 7)
  capturedLng Decimal? @map("captured_lng") @db.Decimal(10, 7)

  // ⚠ WORKAROUND (Batch 6, Ali — 2026-08-23). The collect screen (D7) captures
  // a vendor signature at the moment of collection — a different signature,
  // from a different person, at a different stage than
  // CustodyBatch.signatureUrl (that one is the HUB's, at Batch 7a drop-off).
  // Hand-off photos and location use the columns already meant for them —
  // StatusEvent.photoUrls / lat / lng, "where + photo proof per transition" —
  // written onto the `collected` status_events row instead of duplicated here.
  // Storage object path, not a URL — same reason as every other photo field:
  // the bucket is private and reads go through createSignedUrl.
  signatureUrl String? @map("signature_url")

  collectedAt DateTime @default(now()) @map("collected_at")

  pickup Pickup @relation(fields: [pickupId], references: [id])

  @@map("pickup_receipts")
}

model Certificate {
  id       BigInt @id @default(autoincrement())
  pickupId String @unique @map("pickup_id")
  vendorId String @map("vendor_id") @db.Uuid

  pdfUrl      String @map("pdf_url")
  publicToken String @unique @default(dbgenerated("gen_random_uuid()")) @map("public_token") @db.Uuid

  totalWeightKg   Decimal  @map("total_weight_kg")
  materialSummary Json     @default("[]") @map("material_summary")
  // Impact dashboard. See §6 — this number needs a cited source before demo.
  co2AvoidedKg    Decimal? @map("co2_avoided_kg") @db.Decimal(10, 2)

  certifiedAt DateTime @default(now()) @map("certified_at")

  pickup Pickup  @relation(fields: [pickupId], references: [id])
  vendor Profile @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("certificates")
}

// pickupId null = a consolidated invoice covering a period (fleet accounts).
model Invoice {
  id       String  @id @default(uuid())
  vendorId String  @map("vendor_id") @db.Uuid
  pickupId String? @unique @map("pickup_id")

  number String @unique

  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  subtotalPaise Int @map("subtotal_paise")
  taxPaise      Int @default(0) @map("tax_paise")
  totalPaise    Int @map("total_paise")

  pdfUrl   String?  @map("pdf_url")
  issuedAt DateTime @default(now()) @map("issued_at")

  vendor Profile @relation(fields: [vendorId], references: [id])
  pickup Pickup? @relation(fields: [pickupId], references: [id])

  @@index([vendorId])
  @@map("invoices")
}

// ── Below: scaffolded for the Agent + Admin apps so neither needs a second
// migration. No customer-app screen reads these. Seed one row each and move on.

model Facility {
  id       String   @id @default(uuid())
  name     String
  location String
  lat      Decimal? @db.Decimal(10, 7)
  lng      Decimal? @db.Decimal(10, 7)

  capacityKg Decimal? @map("capacity_kg") @db.Decimal(10, 2)
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  manifests      DispatchManifest[]
  custodyBatches CustodyBatch[]

  @@map("facilities")
}

model Recycler {
  id        String @id @default(uuid())
  name      String
  cpcbRegNo String @unique @map("cpcb_reg_no")

  acceptedChemistries BatteryType[] @map("accepted_chemistries")
  capacityKg          Decimal?      @map("capacity_kg") @db.Decimal(10, 2)
  isActive            Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  manifests DispatchManifest[]

  @@map("recyclers")
}

model DispatchManifest {
  id         String @id @default(uuid())
  facilityId String @map("facility_id")
  recyclerId String @map("recycler_id")

  manifestNo String         @unique @map("manifest_no")
  status     ManifestStatus @default(draft)

  // BatteryItem ids in this dispatch. Json rather than a join table because a
  // manifest is an immutable snapshot once dispatched — it must not change when
  // the underlying items do.
  itemIds Json @default("[]") @map("item_ids")

  totalWeightKg Decimal?  @map("total_weight_kg") @db.Decimal(10, 2)
  dispatchedAt  DateTime? @map("dispatched_at")
  confirmedAt   DateTime? @map("confirmed_at")

  // What actually came back, per metal, for the WHOLE load — captured at
  // reconciliation (Admin Batch 7). Shape: [{ material, recovered_kg }], the
  // same stable keys Certificate.materialSummary and aggregateMaterials() use.
  //
  // Null until reconciled, and it is the only MEASURED recovery figure the
  // platform holds: everything upstream of it (Offer.materialBreakdown, the
  // engine's yields) is an estimate made before the batteries were opened. The
  // certificate prefers this and falls back to the estimate, saying which.
  //
  // A manifest carries items from several pickups, so a certificate takes this
  // pro-rated by that pickup's share of the load — see buildCertificatePayload.
  recoveryData Json? @map("recovery_data")

  createdAt DateTime @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  recycler Recycler @relation(fields: [recyclerId], references: [id])

  @@index([status])
  @@map("dispatch_manifests")
}

// One hub drop-off: the agent hands a set of collected pickups to a facility.
//
// NOT DispatchManifest. A manifest is facility → recycler (build doc §6); this
// is agent → facility. Different edge of the chain of custody, different
// actors, different document — reusing the manifest would make both wrong.
model CustodyBatch {
  id         String @id @default(uuid())
  agentId    String @map("agent_id") @db.Uuid
  facilityId String @map("facility_id")

  batchNo String @unique @map("batch_no")

  totalWeightKg Decimal @map("total_weight_kg") @db.Decimal(10, 2)
  itemCount     Int     @map("item_count")

  // Attested by the agent, not by the hub — there is no hub-staff app. This is
  // the weakest link in the chain of custody and is open question 3 to the
  // company (PLAN_FIELD_AGENT_APP.md §7).
  receivingStaffName String @map("receiving_staff_name")

  // Storage object path, not a URL. Every bucket is private; reads go through
  // createSignedUrl like every other object. Null until Batch 7a captures it.
  signatureUrl String? @map("signature_url")

  // Nullable for the same reason Address.lat/lng are: the agent can deny
  // location permission and the hand-off must still be recordable.
  lat Decimal? @db.Decimal(10, 7)
  lng Decimal? @db.Decimal(10, 7)

  // Rendered lazily on first download, same as PickupReceipt.pdfUrl (Batch 7b).
  pdfUrl String? @map("pdf_url")

  handedOffAt DateTime @default(now()) @map("handed_off_at")
  createdAt   DateTime @default(now()) @map("created_at")

  agent    Profile  @relation(fields: [agentId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])
  pickups  Pickup[]

  @@index([agentId, handedOffAt(sort: Desc)])
  @@map("custody_batches")
}

model SafetyChecklist {
  id       String @id @default(uuid())
  pickupId String @unique @map("pickup_id")
  agentId  String @map("agent_id") @db.Uuid

  // { terminalsInsulated: bool, fireSafeCrate: bool, noMixedChemistry: bool, ... }
  items  Json    @default("{}")
  passed Boolean @default(false)

  completedAt DateTime @default(now()) @map("completed_at")

  pickup Pickup @relation(fields: [pickupId], references: [id])

  @@map("safety_checklists")
}

// ── Admin console (admin_app_v1) ─────────────────────────────────────────────
// Three new tables, all written ONLY through the service role by the admin app.
//
// 🔴 RLS: all three are closed (AD3) — RLS enabled, ZERO policies, so an
// `authenticated` session sees nothing. That is deliberate, not an oversight:
// the admin app reads and writes through Prisma as the table owner (which
// bypasses RLS) and its access boundary is the proxy guard plus in-code role
// checks, the same posture as D10 for the agent app. The `enable row level
// security` statements live in supabase/policies.sql with every other policy,
// per the repo's Prisma-owns-structure / SQL-owns-RLS split.
//
// 🔴 `@default(uuid())` is a PRISMA-CLIENT default, not a database one. It
// applies to `prisma.x.create()` and NOT to a raw service-role insert through
// PostgREST — trap 3. Generate the id in the action for any non-Prisma write.

// The published pricing configuration the engine runs against.
//
// APPEND-ONLY. Publishing writes a NEW row and deactivates the old one; a row
// is never updated in place, because a quote already priced against v-n must
// still be explainable after v-n+1 ships. `parentVersion` is what makes the
// diff on the config screen (B02) possible.
//
// ⚠ TWO VERSION STRINGS, and they are not the same thing.
//   `version`         — this row's PUBLISH identity, e.g. "v2026-08-26-r1".
//   `config.config_version` — the ENGINE's own build stamp inside the JSON,
//                             "v0.1.0-placeholder" in DEFAULT_CONFIG today.
// The seeded row keeps DEFAULT_CONFIG byte-identical, so the two disagree on a
// fresh seed. 🔴 Batch 11's getActiveConfig() has to decide which one the
// engine's audit output should name — see "Batch 1 — as built" in
// docs/ADMIN_TASKS.md. Do not "fix" it by rewriting the JSON here; that would
// break the drift test that guarantees no price moves.
model EngineConfig {
  id String @id @default(uuid())

  version  String  @unique
  config   Json
  // Exactly one row should be true. Enforced in the publish action (deactivate
  // then insert, in one transaction), not by a partial unique index — Prisma
  // cannot express one, and a raw index here would not survive a schema reset.
  isActive Boolean @default(false) @map("is_active")

  note          String?
  publishedBy   String?  @map("published_by") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at")
  parentVersion String?  @map("parent_version")

  createdAt DateTime @default(now()) @map("created_at")

  publisher Profile? @relation(fields: [publishedBy], references: [id])

  @@index([isActive])
  @@index([publishedAt(sort: Desc)])
  @@map("engine_configs")
}

// One table for every admin action worth answering for (W7).
//
// This is NOT StatusEvent. StatusEvent is pickup-lifecycle-only and keyed to a
// pickup; config publishes, market overrides, exception resolutions, margin
// changes and dispatch assignments have no pickup, or have one only
// incidentally. Both are append-only; neither replaces the other.
//
// `action` is a STRING, not an enum, for two reasons: the values are dotted
// (`pickup.assign`) and so are not legal Prisma enum identifiers, and a ninth
// action should not cost a migration. The closed vocabulary lives in
// packages/core/src/audit.ts as `ADMIN_AUDIT_ACTIONS` — 🔴 write rows through
// that type, never a bare string literal.
model AdminAudit {
  id String @id @default(uuid())

  actorId String @map("actor_id") @db.Uuid
  action  String

  // e.g. ("pickup", "PKP-2026-000101") or ("engine_config", "<uuid>").
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  // The changed fields only, not the whole row. A config publish stores the
  // parent version and the new one, not two 4KB blobs.
  before Json?
  after  Json?
  // Required by the caller for lifecycle.override (B06) — the schema keeps it
  // nullable because most actions do not need one.
  reason String?

  createdAt DateTime @default(now()) @map("created_at")

  // No onDelete: the actor must not be able to disappear out of an audit trail.
  // Prisma's default (Restrict) is exactly right here — leave it alone.
  actor Profile @relation(fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([subjectType, subjectId])
  @@index([actorId])
  @@map("admin_audits")
}

// An engine HOLD or REVIEW flag, and what an admin did about it (W4/AD4).
//
// 🔴 This is per BATTERY ITEM, not per pickup, and it is NOT a status. The
// engine flags an item; a pickup carrying a flagged item still sits at whatever
// lifecycle stage it reached. There is deliberately no per-item status column
// (AD6) and no new PickupStatus value (AD4).
//
// "Open" is `resolvedAt IS NULL`. There is no open/closed boolean to drift out
// of step with the resolution fields.
model ItemException {
  id String @id @default(uuid())

  batteryItemId String        @map("battery_item_id")
  kind          ExceptionKind
  // Machine-readable trigger, e.g. "soh_below_gate" / "damage_score_high" /
  // "bms_anomaly". `detail` is the human sentence next to it on D02.
  cause         String
  detail        String?

  openedAt DateTime @default(now()) @map("opened_at")

  resolution ExceptionResolution?
  resolvedBy String?              @map("resolved_by") @db.Uuid
  resolvedAt DateTime?            @map("resolved_at")
  notes      String?

  batteryItem BatteryItem @relation(fields: [batteryItemId], references: [id], onDelete: Cascade)
  resolver    Profile?    @relation(fields: [resolvedBy], references: [id])

  @@index([batteryItemId])
  // /exceptions filters to the open ones first; this is the index that read
  // uses. Nulls sort last on a DESC index in Postgres, so open rows are not at
  // the front of it — the screen filters, it does not rely on ordering.
  @@index([resolvedAt])
  @@map("item_exceptions")
}

# Copy to .env and fill in. Same two values as apps/customer/.env.local.
# Prisma reads these from the schema's env() calls, so they must exist here
# too — the app's .env.local is not enough for migrations or the seed.
#
# DATABASE_URL = POOLED string (pgBouncer, port 6543)
# DIRECT_URL   = DIRECT string (port 5432) — migrations can't run through the pooler
DATABASE_URL=
DIRECT_URL=

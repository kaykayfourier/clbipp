{
  "name": "clbipp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=customer",
    "dev:agent": "turbo run dev --filter=agent",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "npm run db:migrate --workspace=@clbipp/database",
    "reset-demo": "npm run reset-demo --workspace=@clbipp/database",
    "smoke": "node scripts/smoke.mjs",
    "assign-job": "npm run assign-job --workspace=@clbipp/database --"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}

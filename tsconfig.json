{
  "compilerOptions": {
    "target": "ES2017",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["dom", "dom.iterable", "esnext"],

    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "jsx": "react-jsx",

    "incremental": true,

    "plugins": [
      {
        "name": "next"
      }
    ],

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
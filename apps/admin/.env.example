# Admin console. Copy to .env.local and fill in. Ask Aamir for the values —
# .env.local is gitignored and these are not recoverable from the repo.
#
# Same Supabase project as apps/customer and apps/agent: one database, one auth
# pool, one set of roles. The three apps are separated by profiles.role at the
# proxy, not by project — so these values are identical to the other two
# .env.local files.
#
# Supabase project: xlssgnnrtautldouirkt
# Dashboard → Project Settings → API for the first three.

# Public by design — RLS is the security boundary, not this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_, never use it in
# a client component.
#
# ⚠ This app leans on it harder than the other two. Under AD3 the admin console
# has NO RLS policies at all — it reads and writes through Prisma and the
# service role, and in-code role checks are the ENTIRE access boundary. Every
# lifecycle write must re-verify `role === 'admin'` from the SESSION, never from
# a form field. apps/agent/src/app/(agent)/job/[id]/actions.ts is the reference
# pattern and Batch 3 copies it verbatim.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma. Dashboard → Project Settings → Database → Connection string.
# DATABASE_URL  = the POOLED string (pgBouncer, port 6543)
# DIRECT_URL    = the DIRECT string (port 5432) — migrations can't use the pooler
DATABASE_URL=
DIRECT_URL=

# PAYMENTS_MODE is deliberately NOT set. Absent → "simulated", and an
# unrecognised value also falls back to simulated, so a typo can never be read
# as "settle real money". Leave it out.

# No ANDROID_* vars: the admin console is a desktop app, not a PWA and not a TWA
# (AD11, R5). There is no manifest, no service worker and no install prompt.

# Field Agent app. Copy to .env.local and fill in. Ask Aamir for the values —
# .env.local is gitignored and these are not recoverable from the repo.
#
# Same Supabase project as apps/customer: one database, one auth pool, one
# set of roles. The apps are separated by profiles.role at the proxy, not by
# project — so these values are identical to apps/customer/.env.local.
#
# Supabase project: xlssgnnrtautldouirkt
# Dashboard → Project Settings → API for the first three.

# Public by design — RLS is the security boundary, not this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_, never use it
# in a client component. Used by @clbipp/auth/admin for signed photo URLs,
# PDF storage writes, and every agent lifecycle write — which re-verifies
# pickup.agentId === user.id in code, because the service role bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma. Dashboard → Project Settings → Database → Connection string.
# DATABASE_URL  = the POOLED string (pgBouncer, port 6543)
# DIRECT_URL    = the DIRECT string (port 5432) — migrations can't use the pooler
DATABASE_URL=
DIRECT_URL=

# PAYMENTS_MODE is deliberately NOT set. Absent → "simulated", and an
# unrecognised value also falls back to simulated, so a typo can never be
# read as "settle real money". Leave it out.

# Android TWA (Play Store) — optional, only once an Android app exists.
# Serves /.well-known/assetlinks.json so Android drops the browser address bar.
# See docs/ANDROID_TWA_BUILD.md. Unset is fine; the endpoint returns [].
ANDROID_PACKAGE_NAME=
ANDROID_CERT_FINGERPRINTS=
